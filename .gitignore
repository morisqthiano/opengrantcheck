# OpenGrantCheck root ignores
.DS_Store
Thumbs.db
*.log
logs/

# Local environment files
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Dependencies and build output
node_modules/
backend/vendor/
frontend/node_modules/
frontend/dist/
dist/

# Laravel generated files
backend/public/storage
backend/storage/*.key
backend/storage/app/public/guidelines/*
backend/storage/app/public/proposals/*
!backend/storage/app/public/guidelines/.gitkeep
!backend/storage/app/public/proposals/.gitkeep
backend/storage/framework/testing/disks/
backend/storage/framework/views/*.php

# Local SQLite runtime database
backend/database/database.sqlite

# Test, cache, and tool output
coverage/
.nyc_output/
.phpunit.cache/
backend/.phpunit.cache/
backend/.phpunit.result.cache
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tool/editor metadata
.idea/
.vscode/
.vscode-test/
